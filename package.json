{
  "name": "relay-slack-tasks",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "socket": "node --env-file-if-exists=.env src/socket.js",
    "demo": "DEMO_MODE=true node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "dev:cloudflare": "wrangler dev --test-scheduled",
    "deploy:cloudflare": "wrangler deploy"
  },
  "devDependencies": {
    "miniflare": "^5.20261117.0-beta",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
