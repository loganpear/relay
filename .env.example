# Node 24 or later. Keep credentials out of source control.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Set this to the workspace ID where you installed the app.
SLACK_TEAM_ID=
# While testing, accept commands only in your private test channel.
SLACK_ALLOWED_CHANNEL_ID=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/relay.sqlite
# Timezone used by due-date/time inputs and deadline displays.
TASK_TIMEZONE=America/New_York
# Demo uses a separate database and only runs on loopback.
DEMO_MODE=false

# Optional: add files:read and reinstall Relay before enabling image uploads.
SLACK_IMAGE_UPLOADS=false

# Reminders are enabled by default. Set off to disable them for this instance.
RELAY_REMINDERS=on
# Daily reminder times in each assignee's Slack time zone.
REMINDER_DIGEST_TIME=09:00
REMINDER_DUE_DAY_TIME=16:00
