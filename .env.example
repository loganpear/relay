# Node 24 or later. Keep credentials out of source control.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Set this to the workspace ID where you installed the app.
SLACK_TEAM_ID=
# While testing, accept commands only in your private test channel.
SLACK_ALLOWED_CHANNEL_ID=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/relay.sqlite
# Demo uses a separate database and only runs on loopback.
DEMO_MODE=false
