{
  "display_information": {
    "name": "Relay",
    "description": "Assign, track, and review tasks without leaving Slack.",
    "background_color": "#254B42"
  },
  "features": {
    "bot_user": {
      "display_name": "Relay",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/task",
        "description": "Assign a task or request changes",
        "usage_hint": "@person Task title --due YYYY-MM-DD",
        "should_escape": true
      },
      {
        "command": "/tasks",
        "description": "List tasks in this channel",
        "usage_hint": "mine | team | review | all",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
